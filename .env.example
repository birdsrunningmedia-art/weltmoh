# Copy to .env (never commit .env). All secrets stay on the office machine.
# Local SQLite file (default ./data/weltmoh.db)
SQLITE_DB_PATH=./data/weltmoh.db
# Random 32+ char string for signing login cookies. Generate once, keep secret.
SESSION_SECRET=change-me-to-a-long-random-string
# Neon Postgres URL — used ONLY by the sync job / restore flow (Bucket 4).
NEON_DATABASE_URL=postgresql://user:password@host/db?sslmode=require
